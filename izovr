#!/usr/bin/env bash
# The entry point to everything in this repo. ./izovr --help lists the commands.
# Without a command it runs the check of every setting and changes nothing.
# start, stop, session, nuke, verify and measure are its own commands.
# Any other name runs that script from scripts/ (or from alyx/, after "alyx")
# and passes the rest of the arguments on, so each script's --help still works.
set -uo pipefail
cd "$(dirname "$0")"

# --brief may stand anywhere. It is not passed on: the scripts read IZOVR_BRIEF,
# and a script with IZOVR_MODES would reject the word.
ARGS=()
for a in "$@"; do
    if [[ "$a" == "--brief" ]]; then export IZOVR_BRIEF=1; else ARGS+=("$a"); fi
done
set -- ${ARGS[@]+"${ARGS[@]}"}
source scripts/lib.sh

# A runnable script in a directory: executable, not a helper that is sourced.
runnable() { [[ -f "$1" && -x "$1" && "$1" != *.py && "$1" != */lib.sh && "$1" != */common.sh ]]; }

# The first sentence of the comment block at the top of a script. A leading
# "SESSION SETTING." or "PERMANENT SETTING." is a group tag, not the description.
describe() {
    awk 'NR==1{next} /^#[[:space:]]*$/||!/^#/{exit} {sub(/^# ?/,""); s=s (s?" ":"") $0} END{print s}' "$1" |
        sed -E 's/^(SESSION|PERMANENT) SETTING\. //; s/^([^.]*[.:])( .*)?$/\1/'
}

usage() {
    cat <<'U'
usage: izovr [command] [--brief]
  (no command)         Check every setting. Change nothing.
  start                Start the VR session.
  stop                 Stop the VR session.
  session              Show the steps before and after playing.
  nuke                 Close every SteamVR process.
  verify               Check the running VR session.
  measure [seconds]    Count stream problems during play.
  <script> [option]    Run one script. Its --help shows the options.
  alyx <script> [option]
                       Run one Half-Life: Alyx script.
  --brief              Hide the probe lines.
  -h, --help           Show this help.

scripts
U
    local f
    for f in scripts/* alyx/*; do
        runnable "$f" || continue
        n=${f#scripts/}; n=${n/#alyx\//alyx }
        printf '  %-22s %s\n' "$n" "$(describe "$f")"
    done
    echo
}

# A command of izovr itself takes no further argument, except measure.
no_more() { (( $# == 0 )) || unknown_option "$1"; }

CMD="${1:-}"
case "$CMD" in
    -h|--help) no_more "${@:2}"; usage; exit 0 ;;
    ""|start|stop|session) no_more "${@:2}" ;;
    nuke)    no_more "${@:2}"; exec ./scripts/steamvr-nuke --apply ;;
    verify)  no_more "${@:2}"; exec ./scripts/vr-verify ;;
    measure)
        (( $# <= 2 )) || unknown_option "$3"
        [[ $# -lt 2 || "$2" =~ ^[0-9]+$ ]] || unknown_option "$2"
        exec ./scripts/measure "${@:2}" ;;
    alyx)
        [[ -n "${2:-}" ]] && runnable "alyx/$2" || unknown_option "alyx${2:+ $2}"
        exec "./alyx/$2" "${@:3}" ;;
    *)
        [[ "$CMD" != */* ]] && runnable "scripts/$CMD" || unknown_option "$CMD"
        exec "./scripts/$CMD" "${@:2}" ;;
esac

PERMANENT=(rt-priority regdomain firewall-ports gpu-isolation dongle-powersave polkit-network overlay-layout)
CAVEAT=(idle-wifi-card vrlink-encoder)
SESSION=(vpn-tunnel dongle-lowlatency pipewire-resample overlay)

STEAMVR_START_WAIT=60
SESSION_WAIT=300

if [[ "$CMD" == session ]]; then
    printf '\n%sBefore playing%s\n' "$C_B" "$C_0"
    cat <<'A'
  plug in the dongle
  ./izovr start                         tunnel, SteamVR, WayVR
  ./scripts/dongle-lowlatency --apply   optional radio tweaks
  ./scripts/pipewire-resample --apply   only if audio crackles
A
    printf '\n%sAfter playing%s\n' "$C_B" "$C_0"
    cat <<'B'
  ./izovr stop                          WayVR, SteamVR, tunnel
  ./scripts/pipewire-resample --restore
B
    echo
    exit 0
fi

# start and stop state their intent, so the scripts they call do not ask again.
# sudo still asks for the password.
if [[ "$CMD" == start ]]; then
    export IZOVR_YES=1
    title "Start the VR session"

    # An orphan from an earlier run counts as running but serves nothing.
    if steamvr_running && ! steamvr_live; then
        steamvr_stop || exit 1
    fi

    # vrlink binds every interface at startup, so the tunnel must stop first.
    if [[ "$(systemctl is-active "$VPN_UNIT" 2>/dev/null)" == active ]]; then
        steamvr_running && restart=1 || restart=0
        ./scripts/vpn-tunnel --apply || exit 1
        if (( restart )); then
            info "vrlink binds its transports at startup. The script restarts SteamVR."
            steamvr_stop || exit 1
        fi
    fi

    # For the same reason the dongle must be connected to the headset first. The
    # dongle is a client of the access point in the headset, so it has no link
    # while the headset is off. A SteamVR started before that streams over eno1
    # through the router, and the headset does not see the dongle.
    # The wait has no limit: the headset often goes on after this script starts.
    # Ctrl+C stops it.
    if ! dongle_connected; then
        info "Plug in the dongle. Turn on the headset."
        until dongle_connected; do sleep 1; done
    fi
    ok "The dongle is connected to the headset."
    if steamvr_running && ! vrlink_uses_dongle; then
        info "vrlink does not use the dongle. The script restarts SteamVR."
        steamvr_stop || exit 1
    fi

    if ! steamvr_running; then
        # The run is up when vrserver.txt names the PID of the live vrserver in its
        # startup line. Before that, vr_session would read the previous run.
        info "Steam starts SteamVR."
        setsid -f steam "steam://rungameid/$STEAMVR_APPID" </dev/null >/dev/null 2>&1
        for _ in $(seq "$STEAMVR_START_WAIT"); do
            live=$(steamvr_procs | awk '$2 == "vrserver" {print $1; exit}')
            [[ -n "$live" && "$(vrserver_run_pid)" == "$live" ]] && break
            sleep 1
        done
        if ! steamvr_running; then
            bad "SteamVR does not start in $STEAMVR_START_WAIT s. Start SteamVR by hand."
            exit 1
        fi
    fi
    ok "SteamVR runs."

    # WayVR needs only a running SteamVR. Its bindings are plain sources, no chords,
    # and SteamVR loads them again for a controller that turns on later.
    ./scripts/overlay --apply || exit 1

    read -r link hmd ctl <<< "$(vr_session)"
    if ! (( link && hmd && ctl >= 2 )); then
        info "Put on the headset. Turn on both controllers."
    fi
    said_hmd=0; said_ctl=0
    for _ in $(seq "$SESSION_WAIT"); do
        read -r link hmd ctl <<< "$(vr_session)"
        (( link && hmd )) && (( !said_hmd )) && { ok "The headset is connected."; said_hmd=1; }
        (( ctl >= 2 )) && (( !said_ctl )) && { ok "Both controllers are on."; said_ctl=1; }
        (( link && hmd && ctl >= 2 )) && break
        sleep 1
    done
    if ! (( link && hmd && ctl >= 2 )); then
        miss "The session is not ready after $SESSION_WAIT s."
    fi

    info "Close the Steam dashboard with the System button. The dashboard blocks input to WayVR."
    echo
    exit 0
fi

if [[ "$CMD" == stop ]]; then
    export IZOVR_YES=1
    title "Stop the VR session"
    ./scripts/overlay --restore
    title "SteamVR processes"
    steamvr_stop
    if [[ "$(systemctl is-active "$VPN_UNIT" 2>/dev/null)" != active ]]; then
        ./scripts/vpn-tunnel --restore
    fi
    info "Unplug the dongle. Steam retries the connection every 60 s while the dongle is in."
    echo
    exit 0
fi

printf '\n%s== PERMANENT - set once, never think about again ==%s\n' "$C_B" "$C_0"
for s in "${PERMANENT[@]}"; do ./scripts/"$s"; done
printf '\n%s== PERMANENT, WITH ONE CATCH ==%s\n' "$C_B" "$C_0"
for s in "${CAVEAT[@]}"; do ./scripts/"$s"; done
printf '\n%s== PER SESSION - switch on before, off after ==%s\n' "$C_B" "$C_0"
for s in "${SESSION[@]}"; do ./scripts/"$s"; done
printf '\n%sHide the probe lines:%s ./izovr --brief\n' "$C_B" "$C_0"
printf '%sChecklist:%s ./izovr session    %sDiagnostics:%s ./scripts/vr-verify, ./scripts/measure\n\n' "$C_B" "$C_0" "$C_B" "$C_0"
