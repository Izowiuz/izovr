#!/usr/bin/env bash
# SESSION SETTING. The part of Valve's low-latency mode that works here.
#
# SteamOS ships holo-realtek-firmware-toggles (Valve, MIT). Its
# `set-low-latency-mode on` flips seven things; four go through
# /sys/kernel/debug/ieee80211/*/rtw89, which openSUSE's kernel does not build
# (no CONFIG_MAC80211_DEBUGFS, no CONFIG_RTW89_DEBUGFS - verified 26.09, the
# directory does not exist). Those four are out of reach:
#
#   HW_SCAN off        disables the hardware scan that crashes the driver (issue 13643)
#   pd-thresh -75      static packet-detection threshold
#   aggressive EDCA    "roughly inline with what Steam manually sets on Windows"
#   INACTIVE_PS off    -> reachable another way, see ./scripts/dongle-powersave
#
# What this script does, all via iw:
#   amsdu off          Valve's comment: "realtek's driver has a bug with this aggregation"
#   mcs-rates 0-9      caps peak throughput to gain resilience
#   power_save off     host side
#
# Does not persist across reconnects by design - it is a per-session tweak.
set -uo pipefail
source "$(dirname "$0")/lib.sh"

D=$(dongle_iface)
title "Dongle low-latency tweaks (session)"
[[ -z "$D" ]] && { miss "dongle not plugged in"; exit 0; }

case "$MODE" in
  help) sed -n '2,22p' "$0" | sed 's/^# \?//'; exit 0 ;;
  check)
      probe "iw dev $D get power_save; iw dev $D link"
      ps=$(iw dev "$D" get power_save 2>/dev/null | awk '{print $NF}')
      cmp_state "power save" "$ps" "off"
      iw dev "$D" link 2>/dev/null | grep -E "freq|signal|tx bitrate" | sed 's/^\s*/    /'
      info "amsdu and mcs caps cannot be read back from iw, so --apply is idempotent"
      hint "$0"
      ;;
  apply)
      info "iw dev $D set tidconf tids 0xff amsdu off"
      info "iw dev $D set bitrates he-mcs-5 1:0-9 2:0-9 he-mcs-6 1:0-9 2:0-9"
      info "iw dev $D set power_save off"
      confirm "apply?" || { miss "cancelled"; exit 0; }
      sudo iw dev "$D" set tidconf tids 0xff amsdu off 2>/dev/null && ok "amsdu off" || miss "amsdu: failed"
      sudo iw dev "$D" set bitrates he-mcs-5 1:0-9 2:0-9 he-mcs-6 1:0-9 2:0-9 2>/dev/null && ok "mcs 0-9" || miss "bitrates: failed"
      sudo iw dev "$D" set power_save off 2>/dev/null && ok "power save off"
      ;;
  restore)
      sudo iw dev "$D" set tidconf tids 0xff amsdu on 2>/dev/null && ok "amsdu on"
      sudo iw dev "$D" set bitrates 2>/dev/null && ok "bitrates default"
      ;;
esac
